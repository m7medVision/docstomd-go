# Copy to bench.env (git-ignored) and point at your local checkouts.
# Every key is exported to the baseline build command.

# Formats bench baseline engine: source checkout, build command run inside
# it, and the built binary (absolute, or relative to the source checkout).
# The binary must print Markdown for `<binary> <file>`.
FORMATS_BASELINE_SRC=/path/to/baseline/checkout
FORMATS_BASELINE_BUILD=cargo build --release --locked --example convert
FORMATS_BASELINE_BIN=/path/to/build/target/release/examples/convert

# Optional: keep build artifacts out of the source checkout.
CARGO_TARGET_DIR=/path/to/build/target
